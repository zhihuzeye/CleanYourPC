<Window x:Class="CleanYourPC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CleanYourPC - 开源广告治理与系统净化工具" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen" Background="#F4F6F9">
    <Window.Resources>
        <!-- 基础按钮通用样式与平滑过渡动画 -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 表格快捷操作轻量按钮样式 -->
        <Style x:Key="SubActionBtn" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 扫描呼吸灯动画 -->
        <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.25" Duration="0:0:0.75"/>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="185"/>
            </Grid.RowDefinitions>

            <!-- 顶部系统基线信息卡片 -->
            <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,14" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 第一行：大标题与操作按钮栏 -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="CleanYourPC 系统净化工具" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                            <Border x:Name="PillScanning" Margin="12,0,0,0" Padding="8,3" Background="#EFF6FF" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="12" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="DotPulse" Width="7" Height="7" Fill="#2563EB" Margin="0,0,5,0"/>
                                    <TextBlock Text="正在深度扫描中..." FontSize="11" Foreground="#2563EB" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnScan" Style="{StaticResource ModernBtn}" Content="1. 开始扫描" Width="105" Height="36" Margin="0,0,8,0" Background="#2563EB" Click="BtnScan_Click"/>
                            <Button x:Name="BtnClean" Style="{StaticResource ModernBtn}" Content="2. 一键清理选中项" Width="140" Height="36" Margin="0,0,8,0" Background="#059669" Click="BtnClean_Click" IsEnabled="False"/>
                            <Button x:Name="BtnRestore" Style="{StaticResource ModernBtn}" Content="恢复历史设置" Width="150" Height="36" Margin="0,0,8,0" Background="#D97706" Click="BtnRestore_Click"/>
                            <Button x:Name="BtnExport" Style="{StaticResource ModernBtn}" Content="导出报告" Width="115" Height="36" Background="#475569" Click="BtnExport_Click" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>

                    <!-- 第二行：系统基线信息（独占全宽卡片，自适应换行，彻底解决文字遮挡截断） -->
                    <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="6" Padding="12,8" BorderBrush="#E2E8F0" BorderThickness="1">
                        <TextBlock x:Name="TxtEnvSummary" Text="正在读取系统环境基线..." FontSize="12.5" Foreground="#475569" TextWrapping="Wrap" LineHeight="20"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 动态扫描进度条与状态统计栏（含一键选中治理项快捷操作） -->
            <Grid Grid.Row="1" Margin="2,0,2,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ProgressBar x:Name="ScanProgressBar" Grid.Row="0" Height="3" IsIndeterminate="True" Foreground="#3B82F6" Background="#E2E8F0" BorderThickness="0" Margin="0,0,0,6" Visibility="Collapsed"/>
                
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtScanStats" VerticalAlignment="Center" Text="点击【1. 开始扫描】自动检测锁屏广告、信息卡片、天气组件、WPS弹窗、输入法推广、无用自启与软件残留（扫描只读无损）。"
                               FontSize="12.5" Foreground="#334155" FontWeight="SemiBold"/>
                    
                    <!-- 一键选中治理项快捷操作组 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnSelectAll" Style="{StaticResource SubActionBtn}" Content="一键全选" Margin="0,0,6,0" Background="#F1F5F9" Foreground="#0F172A" BorderBrush="#CBD5E1" Click="BtnSelectAll_Click" ToolTip="一键选中列表中所有可治理项目"/>
                        <Button x:Name="BtnSelectRecommended" Style="{StaticResource SubActionBtn}" Content="一键推荐" Margin="0,0,6,0" Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#93C5FD" Click="BtnSelectRecommended_Click" ToolTip="一键勾选推荐治理项（A类自动安全项与B类管理员安全项）"/>
                        <Button x:Name="BtnUnselectAll" Style="{StaticResource SubActionBtn}" Content="取消全选" Background="#F1F5F9" Foreground="#64748B" BorderBrush="#CBD5E1" Click="BtnUnselectAll_Click" ToolTip="取消勾选所有治理项目"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 扫描发现的问题列表（带淡入动画） -->
            <DataGrid Grid.Row="2" x:Name="GridScanItems" AutoGenerateColumns="False" CanUserAddRows="False"
                      IsReadOnly="True" SelectionMode="Single"
                      Background="White" BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="34" FontSize="13">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="72" IsReadOnly="True">
                        <DataGridTemplateColumn.Header>
                            <CheckBox x:Name="ChkSelectAllHeader" Content="全选" VerticalAlignment="Center" Click="ChkSelectAllHeader_Click" ToolTip="一键全选 / 取消全选"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="ItemCheckBox_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="风险分级" Binding="{Binding Risk}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="所属分类" Binding="{Binding Category}" Width="140" IsReadOnly="True"/>
                    <DataGridTextColumn Header="治理项目名称" Binding="{Binding Title}" Width="310" IsReadOnly="True"/>
                    <DataGridTextColumn Header="当前状态" Binding="{Binding CurrentState}" Width="130" IsReadOnly="True"/>
                    <DataGridTextColumn Header="目标状态" Binding="{Binding TargetState}" Width="130" IsReadOnly="True"/>
                    <DataGridCheckBoxColumn Header="需提权" Binding="{Binding RequiresAdmin}" Width="65" IsReadOnly="True"/>
                    <DataGridCheckBoxColumn Header="可恢复" Binding="{Binding SupportsRestore}" Width="65" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 底部实时操作日志与清理报告区 -->
            <Border Grid.Row="3" Background="#0F172A" CornerRadius="6" Padding="12" Margin="0,10,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="实时执行日志（支持导出文本格式 TXT 报告与版本快照回滚）" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtLog" Background="Transparent" Foreground="#34D399" BorderThickness="0"
                             FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- “恢复历史快照 (按版本号)” 模态遮罩选择面板 -->
        <Grid x:Name="ModalRestoreHistory" Background="#7F000000" Visibility="Collapsed">
            <Border Background="White" CornerRadius="10" Width="680" MaxHeight="520" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" BorderBrush="#CBD5E1" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="恢复历史设置 - 选择回滚版本号" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Grid.Row="1" Text="系统在每次清理前均自动记录快照版本号。请选择需要回滚的历史版本：" FontSize="13" Foreground="#64748B" Margin="0,6,0,12"/>

                    <!-- 快照版本列表 -->
                    <ListBox Grid.Row="2" x:Name="ListSnapshots" Height="220" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#EFF6FF" CornerRadius="4" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Version}" FontWeight="Bold" Foreground="#2563EB" FontSize="13"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Description}" FontWeight="SemiBold" Foreground="#1E293B" FontSize="13"/>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat='创建时间: {0:yyyy-MM-dd HH:mm:ss}'}" Foreground="#64748B" FontSize="11.5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding ItemCount, StringFormat='包含 {0} 项配置'}" Foreground="#059669" FontWeight="SemiBold" FontSize="12.5"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ModernBtn}" Content="取消关闭" Width="100" Height="36" Background="#94A3B8" Margin="0,0,10,0" Click="BtnCloseRestoreModal_Click"/>
                        <Button x:Name="BtnConfirmRestoreVersion" Style="{StaticResource ModernBtn}" Content="确定按此版本恢复" Width="140" Height="36" Background="#D97706" Click="BtnConfirmRestoreVersion_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>